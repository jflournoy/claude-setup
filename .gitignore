# Claude Code Command Templates - Git Ignore File
# This repository is a reference implementation, so we track MORE than typical projects

# Dependencies
node_modules/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Build outputs (if any future builds are added)
dist/
build/
*.tsbuildinfo

# Testing
coverage/
.nyc_output
*.lcov

# Environment and local settings
.env
.env.local
.env.*.local

# --- Un-ignore this repo's product ---
# The user's global ignore (~/.config/git/ignore) hides CLAUDE.md, CLAUDE_*.md and
# .claude/ so AI config never lands in work repos. THIS repo is where that config
# lives, so re-include it here (repo .gitignore outranks the global one).
# Without these, `git status` silently hides new guides, commands, agents and hooks.
!CLAUDE.md
!CLAUDE_*.md
!.claude/

# VS Code local-history snapshots: editor cruft, not product
.history/

# vexp: machine-local tooling. Hardcodes this machine's extension path and is
# regenerated on every vexp update, so it is never worth pulling into another
# project. Files stay on disk and keep working; they just do not travel.
.vexp/
.codex/
.claude/hooks/
.claude/CLAUDE.md
.github/copilot-instructions.md

# Local Claude settings (user-specific)
.claude/settings.json
.claude/settings.local.json
.claude/workflows/
.claude/issues/
.claude/designs/

# Monitoring status and runtime data
.monitor-status.json
.monitor-status-*.json
.monitor-history.json
.monitor-previous.json
.monitor-config.json

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace

# Temporary files
*.tmp
*.temp
.cache/
tmp/
temp/

# Logs (except session-history which we intentionally track)
logs/
*.log
!session-history/**/*.log

# Optional: Archive directories
archive/
old/
backup/

# Kiro directory
.kiro

# Python (if any Python scripts are added)
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
ENV/

# Note: We intentionally DO NOT ignore:
# - .claude/commands/ (core product)
# - .claude/agents/ (core product)  
# - .claude/metrics.json (self-tracking)
# - session-history/ (learning system)
# - archive/ (archived workflow files)
# - internal/ (project decisions)
# - plans/ (project planning)